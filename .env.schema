# Blissbase env schema — AI-safe. Local KeePass via gitignored `.env.local` (see AGENTS.md).
# https://varlock.dev
#
# @currentEnv=$VARLOCK_ENV
# @defaultRequired=false
# @defaultSensitive=inferFromPrefix('PUBLIC_')
# @generateTsTypes(path=env.d.ts)
# @plugin(@varlock/keepass-plugin)
# @initKeePass(dbPath=$KP_DB_PATH, password=$KP_PASSWORD)
# ----------

# Master password for the KeePass DB (never commit). Set in shell or gitignored `.env.local`.
# @type=kdbxPassword @sensitive @internal
KP_PASSWORD=

# Override if your KDBX is elsewhere. Default: Dropbox/pws/blissbase.kdbx.
# @internal
KP_DB_PATH=/home/samuba/Dropbox/pws/blissbase.kdbx

# --- App / DB ---
DATABASE_URL=
DATABASE_URL_NON_POOLING=
# Playwright/dev flag — not a secret
# @sensitive=false
E2E_TEST=
# Allowlist of admin emails (appears in UI when those users are logged in — not a credential)
# @sensitive=false
ADMIN_EMAILS=
PUBLIC_ADMIN_USER_ID=

# --- Maps ---
GOOGLE_MAPS_API_KEY=
PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=

# --- Supabase ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_API_KEY=

# --- Cloudflare R2 ---
# Host segment of R2 presigned upload URLs returned via /_app/remote
# @sensitive=false
CLOUDFLARE_ACCOUNT_ID=
# X-Amz-Credential in R2/AWS SigV4 presigned URLs returned via /_app/remote
# @sensitive=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style bucket segment in R2 presigned upload URLs returned via /_app/remote
# @sensitive=false
S3_BUCKET_NAME=

# --- Telegram ---
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=
TELEGRAM_BOT_TOKEN=
# New scraper number (preferred). Mint via: bun run scripts/telegram-login.ts
TELEGRAM_APP_SESSION_PRIMARY=
# Old scraper number (fallback during transition)
TELEGRAM_APP_SESSION_FALLBACK=
# Legacy single-session alias; fills FALLBACK when FALLBACK is unset
TELEGRAM_APP_SESSION=

# --- AI / email / misc APIs ---
AI_GATEWAY_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
TINIFY_API_KEY=
RESEND_API_KEY=
BROWSERLESS_API_KEY=
CRON_SECRET=
ENDPOINT_SECRET=

# --- Cloudinary (legacy / optional) ---
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# --- TodoToday scraper ---
TODOTODAY_EMAIL=
TODOTODAY_PASSWORD=

# --- WhatsApp → SQLite R2 ---
WHATSAPP2SQLITE_R2_ACCESS_KEY_ID=
WHATSAPP2SQLITE_R2_SECRET_ACCESS_KEY=
WHATSAPP2SQLITE_R2_BUCKET_NAME=
WHATSAPP2SQLITE_R2_ENDPOINT=

# --- PostHog (Vercel build sourcemaps; optional locally) ---
POSTHOG_PERSONAL_API_KEY=
# Numeric project id (not a secret); short values false-positive varlock Response leak scans
# @sensitive=false
POSTHOG_PROJECT_ID=
